#!./nilgai.lua
# fizzbuzz.ngai
# Spencer Owens
#
# Nilgai Example: FizzBuzz
# Prints the numbers 1 through limit, replacing multiples of 3 with
# "Fizz", multiples of 5 with "Buzz", and multiples of both with
# "FizzBuzz".
#
# Demonstrates: functions, while loops, if/elseif/else, the modulus
# operator, and mixed string/number output.


# Function fizzbuzz
# Uses global variable limit as its parameter (Nilgai functions take no
# arguments, so values are passed through variables).
def fizzbuzz()
{
    i = 1;
    while (i <= limit)
    {
        if (i % 15 == 0)
        {
            output("FizzBuzz", eol);
        }
        elseif (i % 3 == 0)
        {
            output("Fizz", eol);
        }
        elseif (i % 5 == 0)
        {
            output("Buzz", eol);
        }
        else
        {
            output(i, eol);
        }
        i = i + 1;
    }
}


# Main program
limit = 15;
output("FizzBuzz from 1 to ", limit, ":", eol);
fizzbuzz();
